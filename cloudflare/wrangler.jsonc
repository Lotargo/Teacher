{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixie-ai",
  "main": "./worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "910017",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
